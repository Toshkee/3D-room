{
  "name": "ai-lounge",
  "productName": "AI Lounge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI Lounge — a cozy isometric room where your AI bots hang out, work, and talk.",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "vite build --logLevel warn && node server/index.mjs --open",
    "app": "vite build --logLevel warn && electron-builder --mac dir && node electron/install.mjs",
    "app:dev": "vite build --logLevel warn && electron .",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.22.0",
    "postprocessing": "^6.39.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  },
  "build": {
    "appId": "com.pavletosic.ailounge",
    "productName": "AI Lounge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/main.mjs",
      "server/*.mjs",
      "dist/**",
      "package.json"
    ],
    "asar": false,
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    }
  }
}
